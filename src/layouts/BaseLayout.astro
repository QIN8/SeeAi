---
import "../styles/global.css";
import { SITE, withBase } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  canonicalPath = Astro.url.pathname,
} = Astro.props;

const pageTitle = title === SITE.title ? `${SITE.titleZh} · ${SITE.title}` : `${title} · ${SITE.title}`;
const canonical = new URL(canonicalPath, Astro.site);
const ogImage = new URL(withBase("og.png"), Astro.site).href;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,650;1,6..72,500&family=Noto+Serif+SC:wght@400;600;700&family=Source+Sans+3:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={withBase("/")}>
          <span class="brand-mark">见</span>
          <span class="brand-en">{SITE.title}</span>
        </a>
        <nav class="nav" aria-label="主导航">
          <a href={withBase("/")} aria-current={canonicalPath === withBase("/") ? "page" : undefined}>首页</a>
          <a href={withBase("/timeline/")} aria-current={canonicalPath.includes("/timeline") ? "page" : undefined}>年表</a>
          <a href={withBase("/essays/")} aria-current={canonicalPath.includes("/essays") ? "page" : undefined}>文章</a>
          <a href={withBase("/about/")} aria-current={canonicalPath.includes("/about") ? "page" : undefined}>关于</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p class="colophon">
          {SITE.titleZh} / {SITE.title} · {SITE.tagline}<br />
          个人阅读笔记，非正式学术综述。文中年份与篇名均可核对公开文献。
        </p>
        <p>© {new Date().getFullYear()} {SITE.author}</p>
      </div>
    </footer>
  </body>
</html>
